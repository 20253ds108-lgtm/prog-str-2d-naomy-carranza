<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.practicaexamen.controllers.appController">
    <GridPane>
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
        <children>
            <Label text="Nombre: " />
            <Label text="Telefono:" GridPane.rowIndex="1" />
            <TextField fx:id="txtname" GridPane.columnIndex="1" />
            <TextField fx:id="txtcelular" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Parentesco:" GridPane.rowIndex="2" />
         <ComboBox fx:id="parentescofamiliar" prefHeight="25.0" prefWidth="304.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        </children>
    </GridPane>
    <HBox prefHeight="100.0" prefWidth="200.0">
        <Button mnemonicParsing="false" onAction="#onAddPerson" prefHeight="41.0" prefWidth="59.0" text="Agregar" />
        <Button mnemonicParsing="false" onAction="#onUpdate" prefHeight="40.0" prefWidth="68.0" text="Actualizar" />
        <Button mnemonicParsing="false" onAction="#onDelete" prefHeight="40.0" prefWidth="59.0" text="Eliminar" />
      <Button mnemonicParsing="false" onAction="#onClean" prefHeight="40.0" prefWidth="56.0" text="Limpiar" />
    </HBox>
   <HBox prefHeight="100.0" prefWidth="200.0">
      <children>
         <Button mnemonicParsing="false" onAction="#onSearch" prefHeight="25.0" prefWidth="135.0" text="Buscar" />
          <TextField fx:id="txtbusqueda" prefHeight="25.0" prefWidth="466.0" />
      </children>
   </HBox>
    <ListView fx:id="listView" prefHeight="200.0" prefWidth="200.0" />
    <Label fx:id="lblmsg" />
</VBox>
